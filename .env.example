# API
APP_NAME="Indexer Core API"
ENVIRONMENT=local
LOG_LEVEL=INFO
API_PORT=8000
WEB_PORT=4200
API_PREFIX=/api/v1
IMAGE_TAG=local

# Query pipeline registry
# Used when POST /queries omits pipeline_name.
DEFAULT_QUERY_PIPELINE=agentic_rag

# Query classification before retrieval
# Fail open uses deterministic rules when the configured LLM returns invalid output or is unavailable.
QUERY_CLASSIFICATION_FAIL_OPEN=true
QUERY_CLASSIFICATION_MAX_RATIONALE_CHARS=500
TEMPORAL_QUERY_TIMEZONE=UTC

# Information-need decomposition
# This runs independently from classification and planning; deterministic splitting is the fail-open path.
INFORMATION_NEED_DECOMPOSITION_FAIL_OPEN=true
INFORMATION_NEED_MAX_COUNT=6
INFORMATION_NEED_MAX_CHARS=240
INFORMATION_NEED_DECOMPOSITION_MAX_RATIONALE_CHARS=500

# Retrieval planning
# Low-confidence factual classifications use hybrid retrieval plus cross-encoder reranking.
RETRIEVAL_PLANNING_LOW_CONFIDENCE_THRESHOLD=0.55

# Evidence grading after agentic retrieval
# Invalid LLM grading output falls back to deterministic lexical grading when fail-open is enabled.
EVIDENCE_GRADING_FAIL_OPEN=true
EVIDENCE_GRADING_RELEVANCE_THRESHOLD=0.60
EVIDENCE_GRADING_INFORMATION_NEED_SUPPORT_THRESHOLD=0.75
EVIDENCE_GRADING_MAX_CHARS_PER_EVIDENCE=2000
EVIDENCE_GRADING_MAX_RATIONALE_CHARS=500

# Strict final question-level evidence arbitration before answer generation
# Fail-open preserves only evidence already approved by the per-information-need graders.
EVIDENCE_ARBITRATION_FAIL_OPEN=true
EVIDENCE_ARBITRATION_RELEVANCE_THRESHOLD=0.70
EVIDENCE_ARBITRATION_INFORMATION_NEED_SUPPORT_THRESHOLD=0.80
EVIDENCE_ARBITRATION_MAX_CHARS_PER_EVIDENCE=1800
EVIDENCE_ARBITRATION_MAX_RATIONALE_CHARS=500

# Controlled retry / fallback after weak or missing evidence
# A retry re-plans unresolved claims into focused lookups, can increase top-k or switch pipelines,
# and merges new chunks with retained evidence before re-grading every required claim.
RETRIEVAL_RETRY_MAX_RETRIES=2
RETRIEVAL_RETRY_TOP_K_MULTIPLIER=2.0
RETRIEVAL_RETRY_MAX_TOP_K=20
RETRIEVAL_RETRY_EXPAND_QUERY=true
RETRIEVAL_RETRY_MAX_QUERY_CHARS=1200
RETRIEVAL_RETRY_MAX_TOTAL_ATTEMPTS=20
RETRIEVAL_RETRY_MAX_RECLASSIFICATIONS=1
RETRIEVAL_RETRY_MAX_ACCUMULATED_EVIDENCE=40

# PostgreSQL used by Docker Compose
POSTGRES_USER=indexer
POSTGRES_PASSWORD=indexer_password
POSTGRES_DB=indexer
POSTGRES_PORT=5432

# Document ingestion
DOCUMENT_STORAGE_BACKEND=minio
DOCUMENT_STORAGE_DIR=/app/storage/documents
DOCUMENT_STAGING_DIR=/tmp/indexer-ingestion
MAX_UPLOAD_SIZE_MB=250
WEB_MAX_UPLOAD_SIZE=250m
CHUNK_MAX_CHARS=1200
CHUNK_OVERLAP_CHARS=200

# MinIO object storage for uploaded source files
MINIO_ROOT_USER=indexer
MINIO_ROOT_PASSWORD=indexer_password
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET_NAME=indexer-documents
MINIO_SECURE=false
MINIO_REGION=
MINIO_OBJECT_PREFIX=documents
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Qdrant vector store
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=indexer_chunks
QDRANT_ORIGINAL_VECTOR_NAME=original
QDRANT_CONTEXTUAL_VECTOR_NAME=contextual
QDRANT_HIERARCHY_VECTOR_NAME=hierarchy
QDRANT_TIMEOUT_SECONDS=30
QDRANT_PORT=6333

# BM25 keyword retrieval over Qdrant chunk payloads
KEYWORD_SCROLL_BATCH_SIZE=256
KEYWORD_BM25_K1=1.5
KEYWORD_BM25_B=0.75
KEYWORD_CACHE_TTL_SECONDS=30

# Anthropic-style contextual retrieval (opt-in because it adds one LLM call per chunk)
CONTEXTUALIZATION_ENABLED=true
CONTEXTUALIZATION_FAIL_OPEN=false
CONTEXTUALIZATION_MODEL=llama3.2:3b
CONTEXTUALIZATION_NEIGHBOR_CHUNK_COUNT=2
CONTEXTUALIZATION_MAX_NEIGHBOR_CHARS=6000
CONTEXTUALIZATION_MAX_CONTEXT_CHARS=400
CONTEXTUALIZATION_MAX_CONCURRENCY=2
CONTEXTUALIZATION_CLUSTER_TARGET_SIZE=8
CONTEXTUALIZATION_MAX_CLUSTERS=24
CONTEXTUALIZATION_MAX_CLUSTER_SOURCE_CHARS=8000
CONTEXTUALIZATION_MAX_DOCUMENT_SOURCE_CHARS=12000
CONTEXTUALIZATION_MAX_CLUSTER_SUMMARY_CHARS=600
CONTEXTUALIZATION_MAX_DOCUMENT_SUMMARY_CHARS=900

# Hierarchical retrieval summary indexing and broad-to-precise routing
HIERARCHICAL_INDEXING_ENABLED=true
HIERARCHICAL_INDEXING_FAIL_OPEN=false
HIERARCHICAL_DOCUMENT_CANDIDATES=8
HIERARCHICAL_SECTION_CANDIDATES=24
HIERARCHICAL_CHUNK_CANDIDATE_MULTIPLIER=4
HIERARCHICAL_MAX_CHUNK_CANDIDATES=80

# Hybrid retrieval candidate generation and reciprocal-rank fusion
HYBRID_CANDIDATE_MULTIPLIER=4
HYBRID_MAX_CANDIDATES=100
HYBRID_RRF_K=60
HYBRID_VECTOR_WEIGHT=1.0
HYBRID_KEYWORD_WEIGHT=1.0

# Multi-query expansion over the hybrid retriever
MULTI_QUERY_VARIANT_COUNT=3
MULTI_QUERY_INCLUDE_ORIGINAL=true
MULTI_QUERY_CANDIDATE_MULTIPLIER=2
MULTI_QUERY_MAX_CANDIDATES_PER_QUERY=20
MULTI_QUERY_RRF_K=60
MULTI_QUERY_ORIGINAL_QUERY_WEIGHT=1.2
MULTI_QUERY_VARIANT_QUERY_WEIGHT=1.0
MULTI_QUERY_MAX_VARIANT_CHARS=300
MULTI_QUERY_FAIL_OPEN=true

# Shared reranking candidate expansion
RERANK_CANDIDATE_MULTIPLIER=4
RERANK_MAX_CANDIDATES=40

# Ollama LLM-based reranking
RERANK_BATCH_SIZE=8
RERANK_MAX_CHARS_PER_CANDIDATE=4000
OLLAMA_RERANK_MAX_ATTEMPTS=2
OLLAMA_RERANK_FALLBACK_TO_ORIGINAL_RANK=true

# Local cross-encoder reranking
# The Compose bootstrap service downloads this Hub model once into the named volume.
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
CROSS_ENCODER_MODEL_REVISION=c5ee24cb16019beea0893ab7796b1df96625c6b8
CROSS_ENCODER_MODEL_PATH=/root/.cache/huggingface/indexer/cross-encoder
CROSS_ENCODER_LOCAL_FILES_ONLY=true
CROSS_ENCODER_DOWNLOAD_FORCE=false
CROSS_ENCODER_BATCH_SIZE=16
CROSS_ENCODER_MAX_LENGTH=512
CROSS_ENCODER_DEVICE=cpu

# Embeddings
# Use Ollama for real local embeddings. For tests/offline dev, set hashing.
EMBEDDING_PROVIDER=ollama
EMBEDDING_VECTOR_SIZE=768

# Ollama local/container LLM + embedding provider
# Docker Compose API container should use http://ollama:11434.
# Local non-Docker development can use http://localhost:11434.
# OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_RERANK_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_PORT=11434

# Compose bootstrap service
# Runs on compose startup, applies pending Alembic migrations, and no-ops when up to date.
BOOTSTRAP_DB_MAX_ATTEMPTS=30
BOOTSTRAP_DB_RETRY_SECONDS=2

# Local non-Docker override example:
# DATABASE_URL=postgresql+asyncpg://indexer:indexer_password@localhost:5432/indexer
# MINIO_ENDPOINT=localhost:9000
# QDRANT_URL=http://localhost:6333
OLLAMA_BASE_URL=http://host.docker.internal:11434

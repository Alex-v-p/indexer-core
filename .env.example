# API
APP_NAME="Indexer Core API"
ENVIRONMENT=local
LOG_LEVEL=INFO
API_PORT=8000
API_PREFIX=/api/v1

# PostgreSQL used by Docker Compose
POSTGRES_USER=indexer
POSTGRES_PASSWORD=indexer_password
POSTGRES_DB=indexer
POSTGRES_PORT=5432

# Local non-Docker override example:
# DATABASE_URL=postgresql+asyncpg://indexer:indexer_password@localhost:5432/indexer

# API
APP_NAME="Indexer Core API"
ENVIRONMENT=local
LOG_LEVEL=INFO
API_PORT=8000
WEB_PORT=4200
API_PREFIX=/api/v1
IMAGE_TAG=local

# Query pipeline registry
# Used when POST /queries omits pipeline_name.
DEFAULT_QUERY_PIPELINE=baseline_rag

# PostgreSQL used by Docker Compose
POSTGRES_USER=indexer
POSTGRES_PASSWORD=indexer_password
POSTGRES_DB=indexer
POSTGRES_PORT=5432

# Document ingestion
DOCUMENT_STORAGE_BACKEND=minio
DOCUMENT_STORAGE_DIR=/app/storage/documents
DOCUMENT_STAGING_DIR=/tmp/indexer-ingestion
MAX_UPLOAD_SIZE_MB=250
WEB_MAX_UPLOAD_SIZE=250m
CHUNK_MAX_CHARS=1200
CHUNK_OVERLAP_CHARS=200

# MinIO object storage for uploaded source files
MINIO_ROOT_USER=indexer
MINIO_ROOT_PASSWORD=indexer_password
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET_NAME=indexer-documents
MINIO_SECURE=false
MINIO_REGION=
MINIO_OBJECT_PREFIX=documents
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Qdrant vector store
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=indexer_chunks
QDRANT_TIMEOUT_SECONDS=30
QDRANT_PORT=6333

# BM25 keyword retrieval over Qdrant chunk payloads
KEYWORD_SCROLL_BATCH_SIZE=256
KEYWORD_BM25_K1=1.5
KEYWORD_BM25_B=0.75
KEYWORD_CACHE_TTL_SECONDS=30

# Hybrid retrieval candidate generation and reciprocal-rank fusion
HYBRID_CANDIDATE_MULTIPLIER=4
HYBRID_MAX_CANDIDATES=100
HYBRID_RRF_K=60
HYBRID_VECTOR_WEIGHT=1.0
HYBRID_KEYWORD_WEIGHT=1.0

# Reranking candidate expansion and Ollama scoring batches
RERANK_CANDIDATE_MULTIPLIER=4
RERANK_MAX_CANDIDATES=40
RERANK_BATCH_SIZE=8
RERANK_MAX_CHARS_PER_CANDIDATE=4000

# Embeddings
# Use Ollama for real local embeddings. For tests/offline dev, set hashing.
EMBEDDING_PROVIDER=ollama
EMBEDDING_VECTOR_SIZE=768

# Ollama local/container LLM + embedding provider
# Docker Compose API container should use http://ollama:11434.
# Local non-Docker development can use http://localhost:11434.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_RERANK_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_PORT=11434

# Compose bootstrap service
# Runs on compose startup, applies pending Alembic migrations, and no-ops when up to date.
BOOTSTRAP_DB_MAX_ATTEMPTS=30
BOOTSTRAP_DB_RETRY_SECONDS=2

# Local non-Docker override example:
# DATABASE_URL=postgresql+asyncpg://indexer:indexer_password@localhost:5432/indexer
# MINIO_ENDPOINT=localhost:9000
# QDRANT_URL=http://localhost:6333
# OLLAMA_BASE_URL=http://localhost:11434
